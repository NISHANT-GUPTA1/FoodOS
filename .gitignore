!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# --- kept from main ---------------------------------------------------------
# `*.env` catches `prod.env`; `.env.*` above catches `.env.prod`. Both needed.
*.env
.vite/
