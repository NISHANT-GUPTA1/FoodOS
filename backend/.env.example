# FoodOS — copy to backend/.env and fill in.
# .env is gitignored. Never commit a real key.

# --- Agents (Person D) ----------------------------------------------------
# Without a key the agent layer runs its deterministic offline client, which
# produces the same numbers because the numbers were never the model's.
ANTHROPIC_API_KEY=
FOODOS_MODEL=claude-sonnet-5

# Force offline. Set this for the wifi-off rehearsal.
FOODOS_LLM_OFFLINE=0

# Verifier's optional semantic check. The six deterministic checks always run.
FOODOS_VERIFIER_LLM=0

# Corrections allowed before an agent's output is blocked outright.
FOODOS_AGENT_RETRIES=2

# --- API ------------------------------------------------------------------
FOODOS_API_URL=http://localhost:8000

# --- Engine (Person B) ----------------------------------------------------
# Default sustainability weight, 0 to 1. The Plan screen overrides it per request.
FOODOS_LAMBDA=0.5

# Demo date. Must be a Tuesday — the NGO channel exclusion depends on it.
FOODOS_DEMO_DATE=2026-08-11

# Days of synthetic history the generator produces.
FOODOS_HISTORY_DAYS=180

# Seed for the generator. Changing this changes every number in the demo.
FOODOS_SEED=20260811
